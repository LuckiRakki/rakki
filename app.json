{
  "expo": {
    "name": "Rakki",
    "slug": "rakki",
    "version": "1.7.0",
    "orientation": "portrait",
    "icon": "./assets/icons/rakki.png",
    "scheme": "rakki",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121212",
    "ios": {
      "icon": "./assets/icons/app/Rakki.icon",
      "bundleIdentifier": "com.luckirakki.rakki",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "package": "com.luckirakki.rakki",
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/images/splash.png",
          "imageWidth": 110
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-sqlite",
      [
        "expo-video",
        {
          "supportsPictureInPicture": true,
          "supportsBackgroundPlayback": false
        }
      ],
      [
        "./plugins/withGlassAlternateIcons",
        {
          "icons": [
            "./assets/icons/app/SageGlass.icon",
            "./assets/icons/app/SkyGlass.icon",
            "./assets/icons/app/LemonGlass.icon",
            "./assets/icons/app/SandGlass.icon",
            "./assets/icons/app/LavenderGlass.icon",
            "./assets/icons/app/CoralGlass.icon",
            "./assets/icons/app/MintGlass.icon",
            "./assets/icons/app/BlushGlass.icon",
            "./assets/icons/app/AquaGlass.icon",
            "./assets/icons/app/PeachGlass.icon",
            "./assets/icons/app/PeriwinkleGlass.icon",
            "./assets/icons/app/MochaGlass.icon",
            "./assets/icons/app/CyanGlass.icon",
            "./assets/icons/app/LimeGlass.icon",
            "./assets/icons/app/PinkGlass.icon",
            "./assets/icons/app/MidnightGlass.icon"
          ]
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "NekoPlayer",
            "ios": "./assets/icons/neko-player.png"
          },
          {
            "name": "LyricLines",
            "ios": "./assets/icons/lyric-lines.png"
          },
          {
            "name": "ClassicDepth",
            "ios": "./assets/icons/app/ClassicDepth.png"
          },
          {
            "name": "ClassicFlat",
            "ios": "./assets/icons/app/ClassicFlat.png"
          },
          {
