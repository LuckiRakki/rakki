          },
          {
            "name": "MidnightFlat",
            "ios": "./assets/icons/app/MidnightFlat.png"
          }
        ]
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Rakki uses a photo only when you pick it as your profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "NowPlaying",
              "displayName": "Now Playing",
              "description": "The song you're playing, or the last one you played.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryCircular",
                  "accessoryInline"
                ]
              },
              "android": null
            },
            {
              "name": "JumpBackIn",
              "displayName": "Jump Back In",
              "description": "Albums you played recently.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "systemLarge"
                ]
              },
              "android": null
            }
          ]
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "owner": "luckirakki",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6ae8a4dc-a2f5-4e8e-a799-7f9bb3d6e8fc"
      }
    },
    "runtimeVersion": "1.6.3",
    "updates": {
      "url": "https://u.expo.dev/6ae8a4dc-a2f5-4e8e-a799-7f9bb3d6e8fc",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
