{
  "expo": {
    "name": "Rakki",
    "slug": "rakki",
    "version": "1.20.0",
    "orientation": "default",
    "icon": "./assets/icons/rakki.png",
    "scheme": "rakki",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121212",
    "ios": {
      "icon": "./assets/icons/app/Rakki.icon",
      "bundleIdentifier": "com.luckirakki.rakki",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "package": "com.luckirakki.rakki",
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/images/splash.png",
          "imageWidth": 110
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-sqlite",
      [
        "expo-video",
        {
          "supportsPictureInPicture": true,
          "supportsBackgroundPlayback": false
        }
      ],
      [
        "./plugins/withGlassAlternateIcons",
        {
          "icons": [
            "./assets/icons/app/LavenderGlass.icon",
            "./assets/icons/app/MidnightGlass.icon"
          ]
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "NekoPlayer",
            "ios": "./assets/icons/neko-player.png"
          },
          {
            "name": "LyricLines",
            "ios": "./assets/icons/lyric-lines.png"
          },
          {
            "name": "ClassicDepth",
            "ios": "./assets/icons/app/ClassicDepth.png"
          },
          {
            "name": "ClassicFlat",
            "ios": "./assets/icons/app/ClassicFlat.png"
          },
          {
            "name": "LavenderDepth",
            "ios": "./assets/icons/app/LavenderDepth.png"
          },
          {
            "name": "LavenderFlat",
            "ios": "./assets/icons/app/LavenderFlat.png"
          },
          {
            "name": "MidnightDepth",
            "ios": "./assets/icons/app/MidnightDepth.png"
          },
          {
            "name": "MidnightFlat",
            "ios": "./assets/icons/app/MidnightFlat.png"
          }
        ]
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Rakki uses a photo only when you pick it as your profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "NowPlaying",
              "displayName": "Now Playing",
              "description": "The song you're playing, or the last one you played.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryCircular",
                  "accessoryInline"
                ]
              },
              "android": null
            },
            {
              "name": "JumpBackIn",
              "displayName": "Jump Back In",
              "description": "Albums you played recently.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "systemLarge"
                ]
              },
              "android": null
            }
          ]
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "owner": "luckirakki",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6ae8a4dc-a2f5-4e8e-a799-7f9bb3d6e8fc"
      }
    },
    "runtimeVersion": "1.15.0",
    "updates": {
      "url": "https://u.expo.dev/6ae8a4dc-a2f5-4e8e-a799-7f9bb3d6e8fc",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
