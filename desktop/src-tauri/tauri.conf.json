{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rakki",
  "version": "1.2.1",
  "identifier": "com.luckirakki.rakki.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rakki",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Rakki: Jellyfin music, word by word",
    "publisher": "LuckiRakki",
    "copyright": "LuckiRakki. AGPL-3.0.",
    "category": "Music",
    "longDescription": "Rakki for Windows and Linux: your Jellyfin music library with synced lyrics, smart radio and Daily Mixes. Plays through mpv.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "mpv"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5MzU5RTZBMzc1MDUwQTEKUldTaFVGQTNhcDQxK1VVeU00NVFXcjhxQ21WZTE3NW1KcXlONWhpTTlhYkwyR042TnQ5U3g0VloK",
      "endpoints": [
        "https://github.com/LuckiRakki/rakki/releases/download/desktop-updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
